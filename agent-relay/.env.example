FALKOR_HOST=your-instance.falkordb.cloud
FALKOR_PORT=6379
FALKOR_USER=falkordb
FALKOR_PASS=change-me
GROQ_API_KEY=gsk_...
# more Groq keys, tried in order before Gemini (each is a separate quota; leave out the ones you don't have)
# GROQ_API_KEY_2=gsk_...
# GROQ_API_KEY_3=gsk_...
# GROQ_API_KEY_4=gsk_...
# GROQ_API_KEY_5=gsk_...
# optional overrides
# RELAY_EXTRACT_MODEL=openai/gpt-oss-20b
# RELAY_ANSWER_MODEL=openai/gpt-oss-120b

# Gemini: the fallback when every Groq key is out
GEMINI_API_KEY=
# where the web app runs (CORS), comma-separated; * while developing
CORS_ORIGINS=*
# tenant keys are HMACs with this secret (any long random string); derived from FALKOR_PASS if left out
# RELAY_TENANT_SECRET=
# 1 = the demo web app gets every tenant's key (region switching); 0 = keys are handed to each tenant separately
RELAY_DEMO_KEYS=1
# public demo protection (all off when left out): resets/restores/model settings need this key in X-Reset-Key,
# and writes are limited per visitor address per minute
# RELAY_RESET_KEY=
# RELAY_CHAT_PER_MIN=30
# RELAY_WRITES_PER_MIN=90
